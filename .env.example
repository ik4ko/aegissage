# ─────────────────────────────────────────────────────────────────────────────
#  AegisSage — environment
#
#  The site builds and runs with NONE of these set. Everything degrades:
#  contact submissions log to the console instead of persisting, alerts are
#  skipped with a warning, and analytics no-ops. Set them to make it real.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin. Drives metadataBase, canonical URLs, sitemap and OG image
# URLs. Set to the Vercel preview URL on previews.
#
# In production this MUST be the host that serves a 200 without redirecting.
# That is www.aegissage.com — the apex 308s to it. Pointing this at the apex
# makes every canonical and every sitemap entry resolve through a redirect.
NEXT_PUBLIC_SITE_URL=https://www.aegissage.com

# ── Advisor identity ─────────────────────────────────────────────────────────
#
# DELIBERATELY EMPTY. Do not add identity variables here.
#
# The advisor's name, job title, email, phone and headshot are published
# facts about a licensed producer, not per-environment configuration. They
# live in lib/site.ts and are the same in every environment, including
# previews. There is no deployment where the name should differ.
#
# This block previously carried a stale NEXT_PUBLIC_ADVISOR_NAME, a personal
# Gmail address, and a BLANK NEXT_PUBLIC_ADVISOR_PHOTO. Anyone
# seeding a deployment from this file — which is the entire purpose of this
# file — overrode the correct values with stale ones and blanked the
# headshot, while lib/site.ts still read correctly to anyone reviewing the
# code. That failure mode is why these are gone.
#
# The override reads still exist in lib/site.ts and trust-bar.tsx so that an
# existing deployment does not break, and they now treat a blank value as
# unset. Once the variables are cleared from the Vercel project, those reads
# can be deleted outright.

# ── Supabase ─────────────────────────────────────────────────────────────────
# This app has its OWN Supabase project, deliberately isolated from every
# other project on the account. Do not point these at any database that holds
# client or book-of-business data — public contact-form submissions must never
# share a database with client PII.
#
#   Project:  aegissage-website
#   Ref:      oofxhxsjfyuqegicczbu
#   URL:      https://oofxhxsjfyuqegicczbu.supabase.co
#
# The URL and anon key are public by design (the anon key ships to browsers and
# is powerless here — RLS is on with no policies). The service role key is NOT
# public: copy it from Supabase → Project Settings → API, and never give it a
# NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://oofxhxsjfyuqegicczbu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Contact alerts: email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
# Must be a verified sending domain in Resend.
NOTIFY_EMAIL_FROM=AegisSage <notifications@aegissage.com>
# Where new-contact alerts go. Comma-separated for multiple recipients.
NOTIFY_EMAIL_TO=

# ── Contact alerts: SMS (Twilio) ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +15512029079
TWILIO_FROM_NUMBER=
NOTIFY_SMS_TO=

# ── CRM bridge (server-only) ─────────────────────────────────────────────────
# Website -> Agent Factory lead sync. See docs/crm-bridge.md.
# NEVER prefix these NEXT_PUBLIC_: a signing secret in the browser lets anyone
# forge leads into the CRM.
#
# Absent values are a safe no-op: leads accumulate in lead_sync_outbox and
# drain automatically once these are set.
CRM_INGEST_URL=
CRM_INGEST_SECRET=

# Authorises /api/internal/sync-leads (the outbox drain worker).
# Without it the endpoint fails closed and returns 401.
CRON_SECRET=
